<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Viridis</AssemblyName>
    <RootNamespace>Viridis</RootNamespace>
    <Version>0.3.0</Version>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <DebugType>none</DebugType>

    <!-- 游戏程序集目录；换机器时用 -p:Sts2Dir=... 覆盖 -->
    <Sts2Dir Condition="'$(Sts2Dir)' == ''">$(STS2_DATA_DIR)</Sts2Dir>
    <!-- RitsuLib 安装目录（工坊物品 3747602295） -->
    <RitsuLibDir Condition="'$(RitsuLibDir)' == ''">$(STS2_RITSULIB_DIR)</RitsuLibDir>
    <!-- compat 目录必须与游戏版本匹配 -->
    <RitsuLibTarget Condition="'$(RitsuLibTarget)' == ''">0.113.0</RitsuLibTarget>

    <ModsDir Condition="'$(ModsDir)' == '' and '$(Sts2Dir)' != ''">$(Sts2Dir)\..\mods</ModsDir>
    <DeployMod Condition="'$(DeployMod)' == ''">false</DeployMod>
  </PropertyGroup>

  <Target Name="CheckBuildPaths" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(Sts2Dir)\sts2.dll')" Text="Set Sts2Dir or STS2_DATA_DIR to the Slay the Spire 2 assemblies directory." />
    <Error Condition="!Exists('$(RitsuLibDir)\compat\$(RitsuLibTarget)\STS2-RitsuLib.Runtime.dll')" Text="Set RitsuLibDir or STS2_RITSULIB_DIR to the RitsuLib workshop item directory." />
  </Target>

  <ItemGroup>
    <Reference Include="sts2">
      <HintPath>$(Sts2Dir)\sts2.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="GodotSharp">
      <HintPath>$(Sts2Dir)\GodotSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(Sts2Dir)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="STS2-RitsuLib.Runtime">
      <HintPath>$(RitsuLibDir)\compat\$(RitsuLibTarget)\STS2-RitsuLib.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="STS2-RitsuLib">
      <HintPath>$(RitsuLibDir)\compat\$(RitsuLibTarget)\STS2-RitsuLib.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="STS2-RitsuLib.Shared">
      <HintPath>$(RitsuLibDir)\shared\STS2-RitsuLib.Shared.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="DeployToGame" AfterTargets="Build" Condition="'$(DeployMod)' == 'true'">
    <ItemGroup>
      <ModPayload Include="$(TargetPath)" />
      <ModPayload Include="$(MSBuildProjectDirectory)\Viridis.json" />
    </ItemGroup>
    <MakeDir Directories="$(ModsDir)\Viridis" />
    <Copy SourceFiles="@(ModPayload)" DestinationFolder="$(ModsDir)\Viridis" />
    <Message Importance="high" Text="Deployed to $(ModsDir)\Viridis" />
  </Target>

</Project>